# Copy this file to .env.local and fill in each value.
# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys (secret key).
# If you connect Supabase through the Vercel integration, these are filled in for you.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# The password you type at /login to reach the admin.
ADMIN_PASSWORD=choose-a-long-password

# Any long random string (signs your admin login cookie). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
