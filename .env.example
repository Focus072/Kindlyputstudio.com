# Copy this file to .env.local and fill in each value.
# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys (secret key).
# If you connect Supabase through the Vercel integration, these are filled in for you.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: a long random string that signs admin login cookies. If left out,
# one is derived from the Supabase secret key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Optional: the public address used in copied client links.
# Defaults to https://www.kindlyputstudio.com
# NEXT_PUBLIC_SITE_URL=https://www.kindlyputstudio.com

# Optional: content calendar time zone (IANA name). Defaults to America/Los_Angeles.
# NEXT_PUBLIC_STUDIO_TIMEZONE=America/Los_Angeles

# Optional: Buffer API key. Usually pasted in Admin > Calendar > Settings instead.
# BUFFER_API_KEY=
